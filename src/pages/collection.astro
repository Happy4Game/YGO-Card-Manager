---
import AppLayout from '@/layouts/AppLayout.astro'
import PageLoading from '@/components/layout/PageLoading.astro'
import CollectionPage from '@/components/pages/CollectionPage.vue'
---

<AppLayout
  title="Ma collection"
  current="collection"
  description="Gérer sa collection de cartes : quantités, états, emplacements, sauvegarde."
>
  <!-- client:only : composant rendu seulement dans le navigateur (IndexedDB, caméra…).
       Doc : https://docs.astro.build/fr/reference/directives-reference/#clientonly -->
  <CollectionPage client:only="vue">
    <PageLoading slot="fallback" title="Ma collection" />
  </CollectionPage>
</AppLayout>
