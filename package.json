{
  "name": "ygo-card-manager",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "astro preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "build-only": "astro build",
    "type-check": "astro check && vue-tsc --build tsconfig.vue.json",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix --ignore-pattern \"**/*.astro\"",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write src/ e2e/ scripts/ astro.config.ts",
    "lint:ci": "oxlint . --ignore-pattern \"**/*.astro\" && eslint .",
    "format:check": "prettier --check src/ e2e/ scripts/ astro.config.ts",
    "spike:api": "node scripts/spike-ygoprodeck.mjs",
    "check:assets": "node scripts/check-no-card-assets.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/vue": "^7.1.6",
    "@vite-pwa/astro": "^2.0.3",
    "astro": "^7.4.13",
    "dexie": "^4.4.7",
    "pinia": "^4.1.0",
    "vue": "^3.5.46",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.58.2",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/eslint-plugin": "^1.6.13",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-oxlint": "~1.57.0",
    "eslint-plugin-playwright": "^2.10.1",
    "eslint-plugin-vue": "~10.8.0",
    "fake-indexeddb": "^6.2.8",
    "jiti": "^2.6.1",
    "jsdom": "^29.0.1",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.57.0",
    "prettier": "3.8.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "~6.0.0",
    "vite": "^8.3.8",
    "vitest": "^4.1.2",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "license": "MIT"
}
