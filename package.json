{
  "name": "ygo-card-manager",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run assets:ocr",
    "dev": "astro dev",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "astro preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "prebuild-only": "npm run assets:ocr",
    "build-only": "astro build",
    "type-check": "astro check && vue-tsc --build tsconfig.vue.json",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix --ignore-pattern \"**/*.astro\"",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write src/ e2e/ scripts/ astro.config.ts",
    "lint:ci": "oxlint . --ignore-pattern \"**/*.astro\" && eslint .",
    "format:check": "prettier --check src/ e2e/ scripts/ astro.config.ts",
    "spike:api": "node scripts/spike-ygoprodeck.mjs",
    "check:assets": "node scripts/check-no-card-assets.mjs",
    "astro": "astro",
    "assets:ocr": "node scripts/copy-tesseract-assets.mjs"
  },
  "dependencies": {
    "@astrojs/vue": "^7.1.6",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/fra": "1.0.0",
    "@vite-pwa/astro": "^2.0.3",
    "astro": "^7.4.13",
    "dexie": "^4.4.7",
    "pinia": "^4.1.0",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0",
    "vue": "^3.5.46",
    "wasm-feature-detect": "1.10.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tsconfig/node24": "^24.0.6",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-oxlint": "~1.94.0",
    "eslint-plugin-playwright": "^2.12.2",
    "eslint-plugin-vue": "~10.12.1",
    "fake-indexeddb": "^6.2.8",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.1",
    "npm-run-all2": "^9.0.4",
    "oxlint": "~1.94.0",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "license": "MIT"
}
